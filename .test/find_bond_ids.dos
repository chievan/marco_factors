// 1. 查询中证企业债相关指数
corp_bond = select security_id, code, name, short_name from loadTable("dfs://HFNF.index_info", "data") where name like "%中证企业债%" or short_name like "%中证企业债%";

// 2. 查询中债综合财富相关指数
agg_bond = select security_id, code, name, short_name from loadTable("dfs://HFNF.index_info", "data") where name like "%中债综合财富%" or short_name like "%中债综合财富%";

print("=== CSI Corporate Bond Results ===");
print(corp_bond);
print("=== China Bond Composite Wealth Results ===");
print(agg_bond);
