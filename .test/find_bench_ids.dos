// 查找基准标的的 security_id
indices = select security_id, code, name from loadTable("dfs://HFNF.index_info", "data") where code in ["000985", "GTHT06", "CBA00201"];
print("Found Target Indices:");
print(indices);

// 查找 GTHT06 (如果 code 不是 GTHT06)
extra = select security_id, code, name from loadTable("dfs://HFNF.index_info", "data") where name like "%中性%" and name like "%国泰海通%";
print("Potential Neutral Indices:");
print(extra);

// 查找 CBA00201 
extra_bond = select security_id, code, name from loadTable("dfs://HFNF.index_info", "data") where (code like "CBA%" or name like "%中债综合财富%");
print("Potential Bond Indices:");
print(extra_bond);
