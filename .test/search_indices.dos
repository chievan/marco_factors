
i1 = select security_id, name, code, publisher from loadTable("dfs://HFNF.index_info", "data") where name like "%国泰%" or name like "%海通%";
i2 = select distinct product_name, product_code from loadTable("dfs://HAZQ.private_index", "data") where product_name like "%国泰%" or product_name like "%海通%";
print(i1);
print("---");
print(i2);

