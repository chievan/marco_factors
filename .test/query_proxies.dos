// 查询宏观因子的代理指标对应 ID
security = loadTable("dfs://HFNF.common_security", "data");

// 1. 南华沪铜 / 南华农产品 / 螺纹钢
proxies = select * from security where name like "%沪铜%" or name like "%农产品%" or name like "%螺纹钢%" or name like "%商品%";

// 2. 房地产开发指数
realestate = select * from security where name like "%房地产开发%";

// 3. 中债综合财富指标
bond = select * from security where name like "%中债综合财富%";

// 4. USDCNH
fx = select * from security where name like "%USDCNH%";

// 5. 信用利差
credit = select * from security where name like "%信用利差%";

// 输出结果
print("--- 代理指标搜索结果 ---");
print(proxies);
print(realestate);
print(bond);
print(fx);
print(credit);
